@page "/"
@inject BlogService Blog
@inject SiteSettingsService SettingsService

<PageMeta Title="@(settings?.SiteTitle ?? "墨屿")" Description="@settings?.Description" Path="/" />

@if (settings is not null)
{
    <section class="hero">
        <div class="hero-copy reveal">
            <span class="eyebrow">@settings.HeroKicker</span>
            <h1>@settings.HeroTitle</h1>
            <p>@settings.HeroSubtitle</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="/blog">
                    开始阅读
                    <Icon Name="arrow-right" Size="17" />
                </a>
                <a class="text-link" href="/about">关于这座岛 <span>↗</span></a>
            </div>
            <div class="hero-stats">
                <div><strong>@publishedCount</strong><span>篇文章</span></div>
                <div><strong>@tags.Count</strong><span>个话题</span></div>
                <div><strong>@years</strong><span>年记录</span></div>
            </div>
        </div>

        <div class="hero-art reveal reveal-delay-1" aria-hidden="true">
            <div class="hero-art-frame">
                <div class="hero-art-top">
                    <span>ISSUE</span>
                    <span>NO. @DateTime.Now.ToString("yy.MM")</span>
                </div>
                <span class="hero-glyph">墨</span>
                <div class="hero-art-orbit"></div>
                <div class="hero-art-line"></div>
                <p>写代码，也写字。<br />在喧闹的世界里，保留一块安静的地方。</p>
                <div class="hero-art-bottom">
                    <span>INK · ISLE</span>
                    <span class="hero-stamp">屿</span>
                </div>
            </div>
        </div>
    </section>

    @if (featured is not null)
    {
        <section class="section featured-section">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">EDITOR'S PICK</span>
                    <h2>本期推荐</h2>
                </div>
                <span class="section-note">慢慢读，不着急</span>
            </div>

            <article class="featured-post">
                <a class="featured-cover" href="@($"/blog/{featured.Slug}")">
                    @if (!string.IsNullOrWhiteSpace(featured.CoverImageUrl))
                    {
                        <img src="@featured.CoverImageUrl" alt="@featured.Title 封面" />
                    }
                    else
                    {
                        <div class="featured-cover-fallback">
                            <span>@featured.Title.FirstOrDefault()</span>
                        </div>
                    }
                    <span class="featured-issue">FEATURED / @featured.DisplayDate</span>
                </a>
                <div class="featured-copy">
                    <div class="post-meta">
                        <span>@featured.TagList.FirstOrDefault()</span>
                        <span class="meta-dot"></span>
                        <span>@ReadingTime.EstimateMinutes(featured.ContentMarkdown) 分钟阅读</span>
                    </div>
                    <h3><a href="@($"/blog/{featured.Slug}")">@featured.Title</a></h3>
                    <p>@featured.Summary</p>
                    <a class="btn btn-outline" href="@($"/blog/{featured.Slug}")">
                        阅读这篇文章
                        <Icon Name="arrow-right" Size="16" />
                    </a>
                </div>
            </article>
        </section>
    }

    <section class="section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">RECENT NOTES</span>
                <h2>最近写下</h2>
            </div>
            <a class="text-link" href="/blog">全部文章 <Icon Name="arrow-right" Size="15" /></a>
        </div>

        @if (latest.Items.Count == 0)
        {
            <EmptyState Title="第一篇文章正在路上" Description="后台已经准备好了，去写下第一句话吧。" />
        }
        else
        {
            <div class="post-grid">
                @for (var i = 0; i < latest.Items.Count; i++)
                {
                    <PostCard Post="latest.Items[i]" Index="i + 1" />
                }
            </div>
        }
    </section>

    @if (tags.Count > 0)
    {
        <section class="section topics-section">
            <div class="topics-copy">
                <span class="eyebrow">TOPICS ON THE ISLAND</span>
                <h2>沿着话题散步</h2>
                <p>从一个小切口进入，找到气味相近的文字。</p>
            </div>
            <div class="topics-cloud">
                @foreach (var tag in tags)
                {
                    <a class="topic-chip" href="@($"/tag/{Uri.EscapeDataString(tag.Name)}")">
                        <span>#</span>@tag.Name
                        <small>@tag.Count</small>
                    </a>
                }
            </div>
        </section>
    }

    <section class="about-strip">
        <span class="about-strip-mark">“</span>
        <blockquote>写下，是为了在时间经过之后，仍然能认出当时的自己。</blockquote>
        <div class="about-strip-footer">
            <span>@settings.AuthorName</span>
            <a class="text-link" href="/about">关于墨屿 <Icon Name="arrow-right" Size="15" /></a>
        </div>
    </section>

    <section class="cta-banner">
        <div>
            <span class="eyebrow">STAY IN TOUCH</span>
            <h2>让更新安静地抵达</h2>
            <p>没有算法，没有推送。只有新文章发布时，一份简单的 RSS。</p>
        </div>
        <a class="btn btn-light" href="/feed.xml">
            <Icon Name="rss" Size="17" />
            订阅 RSS
        </a>
    </section>
}

@code {
    private SiteSettings? settings;
    private BlogPost? featured;
    private PagedPosts latest = new([], 0, 1, 6);
    private List<TagCloudItem> tags = [];
    private int publishedCount;
    private int years = 1;

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsService.GetAsync();
        var featuredItems = await Blog.GetFeaturedAsync(1);
        featured = featuredItems.FirstOrDefault();
        latest = await Blog.GetPublishedAsync(1, 6);
        tags = await Blog.GetTagsAsync();
        publishedCount = latest.Total;
        years = Math.Max(1, DateTime.UtcNow.Year - 2025);
    }
}
