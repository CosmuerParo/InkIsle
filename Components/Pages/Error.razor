@page "/Error"
@using System.Diagnostics

<PageMeta Title="出了点问题" Description="页面暂时无法显示。" Path="/error" />

<section class="notfound error-page">
    <span class="eyebrow">500 · SOMETHING BROKE</span>
    <h1>岛上起了一阵风。</h1>
    <p>页面暂时无法显示。可以稍后再试，或者先回到首页。</p>
    @if (ShowRequestId)
    {
        <p class="request-id">请求编号：<code>@RequestId</code></p>
    }
    <div class="button-row">
        <a class="btn btn-primary" href="/">回到首页</a>
        <a class="btn btn-ghost" href="/blog">去读文章</a>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = 500;
        }
    }
}
