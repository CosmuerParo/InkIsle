@inject NavigationManager Navigation
@inject SiteSettingsService SettingsService

<PageTitle>@FullTitle</PageTitle>

<HeadContent>
    <meta name="description" content="@ResolvedDescription" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:site_name" content="@SiteName" />
    <meta property="og:title" content="@FullTitle" />
    <meta property="og:description" content="@ResolvedDescription" />
    <meta property="og:type" content="@OgType" />
    <meta property="og:url" content="@CanonicalUrl" />
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <meta property="og:image" content="@AbsoluteImage" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    <meta name="twitter:title" content="@FullTitle" />
    <meta name="twitter:description" content="@ResolvedDescription" />
    @if (!string.IsNullOrWhiteSpace(JsonLd))
    {
        <script type="application/ld+json">@((MarkupString)JsonLd)</script>
    }
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Path { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string OgType { get; set; } = "website";
    [Parameter] public string? JsonLd { get; set; }

    private SiteSettings? settings;
    private string SiteName => settings?.SiteTitle ?? "墨屿";
    private string FullTitle => string.Equals(Title, SiteName, StringComparison.Ordinal)
        ? Title
        : $"{Title} · {SiteName}";
    private string DescriptionText => string.IsNullOrWhiteSpace(Description)
        ? (settings?.Description ?? "在文字的岛屿上，慢一点。")
        : Description!;
    private string ResolvedDescription => DescriptionText;
    private string CanonicalUrl => $"{Navigation.BaseUri.TrimEnd('/')}{Path ?? Navigation.ToBaseRelativePath(Navigation.Uri)}";
    private string AbsoluteImage => ImageUrl!.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? ImageUrl
        : $"{Navigation.BaseUri.TrimEnd('/')}/{ImageUrl.TrimStart('/')}";

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsService.GetAsync();
    }
}
